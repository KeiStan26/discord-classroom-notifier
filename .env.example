# ==============================================================================
# Google Classroom to Discord Notifier - 環境変数設定サンプル
# ==============================================================================
# 本ファイルをコピーして `.env` を作成し、実際の値を設定してください。
# ※ `.env` は機密情報を含むため、絶対にGitへコミットしないでください。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 認証設定
# ------------------------------------------------------------------------------
# Google Cloud ConsoleでダウンロードしたOAuthクライアントID（デスクトップアプリ）のJSONファイルパス
GOOGLE_CREDENTIALS_FILE=credentials.json

# 初回認証完了後に生成されるOAuthトークン（リフレッシュトークン等）の保存先パス
GOOGLE_TOKEN_FILE=token.json

# ------------------------------------------------------------------------------
# 2. Discord Webhook 設定
# ------------------------------------------------------------------------------
# 通知先のDiscordチャンネルのWebhook URL（必須）
# 個別クラス設定（config/courses.json）でwebhook_urlが未設定の場合、このデフォルトURLへ通知されます。
DISCORD_DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 通知時のデフォルトメンション（任意）
# 例: 
#   ロール指定: <@&123456789012345678>
#   ユーザー指定: <@123456789012345678>
#   全員: @everyone または @here
#   メンションなし: 空白
DEFAULT_MENTION=

# ------------------------------------------------------------------------------
# 3. 取得・通知対象の設定
# ------------------------------------------------------------------------------
# 各投稿種別の取得フラグ (true / false)
FETCH_ANNOUNCEMENTS=true
FETCH_COURSEWORK=true
FETCH_MATERIALS=true

# クラス個別設定ファイルのパス（任意）
# 複数クラスを個別Webhookやメンションで管理したい場合に利用します。
COURSES_CONFIG_FILE=config/courses.json

# 特定のコースIDのみをカンマ区切りで対象にする場合（courses.jsonを使わない簡易指定用、空の場合は参加中の全コース）
# 例: TARGET_COURSE_IDS=123456789012,987654321098
TARGET_COURSE_IDS=

# 初回実行時の同期動作 (true / false)
# true の場合、初回実行時に既存の過去投稿をすべて既読扱いとし、次回実行以降の新規投稿のみを通知します（チャンネルの爆撃防止）。
# false の場合、初回実行時に最新の投稿も通知対象とします。
INITIAL_SYNC_MARK_AS_READ=true

# ------------------------------------------------------------------------------
# 4. 常駐・バッチ実行設定
# ------------------------------------------------------------------------------
# デーモン（常駐）モード時のポーリング間隔（秒）
CHECK_INTERVAL_SECONDS=300

# ------------------------------------------------------------------------------
# 5. システム・データ・ログ設定
# ------------------------------------------------------------------------------
# 既読管理データベースやロックファイルの格納ディレクトリ
DATA_DIR=./data

# ログ出力レベル (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ログファイル保存先（空の場合は標準出力のみ）
LOG_FILE=./logs/notifier.log

# ログファイルの最大サイズ（バイト単位、デフォルト: 5MB）
LOG_MAX_BYTES=5242880

# ログファイルのバックアップ世代数
LOG_BACKUP_COUNT=5
