[Unit]
Description=Google Classroom to Discord Notifier (Batch One-Shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 実行ユーザーとグループ（ご自身のLinuxユーザー名に変更してください）
User=ubuntu
Group=ubuntu
# アプリケーションの配置ディレクトリと仮想環境のPythonパス
WorkingDirectory=/opt/classroom-notifier
EnvironmentFile=/opt/classroom-notifier/.env
ExecStart=/opt/classroom-notifier/.venv/bin/python -m src.cli run
# journalctl でログを一元管理
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
